{
  "schemaVersion": 1,
  "id": "blockmind",
  "version": "${version}",
  "name": "BlockMind Minecraft Adapter",
  "description": "Embodied Minecraft sensors and actions for BlockMind Core",
  "authors": ["BlockMind contributors"],
  "contact": {"sources": "https://github.com/BADMAAAN/BlockMind"},
  "license": "Apache-2.0",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.blockmind.minecraft.BlockMindClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "=${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  },
  "suggests": {
    "baritone": "*"
  }
}
